        "grunt-contrib-jshint": "2.1.0",
        "grunt-contrib-uglify": "5.0.1",
        "grunt-contrib-watch": "1.1.0",
        "grunt-jscs": "3.0.1",
        "react": "18.2.0",
        "react-dom": "^18.2.0",
        "stats-js": "1.0.1",
        "three": "0.153.0",
        "vite": "4.4.9",
