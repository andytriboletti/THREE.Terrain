{
  "name": "ecctrl",
  "version": "1.0.92",
  "author": "Erdong Chen",
  "license": "MIT",
  "description": "A floating rigibody character controller for R3F",
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "control",
    "character-control"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/ecctrl.git"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "type": "module",
  "types": "./dist/Ecctrl.d.ts",
  "main": "./dist/Ecctrl.cjs",
  "module": "./dist/Ecctrl.js",
  "exports": {
    "types": "./dist/Ecctrl.d.ts",
    "require": "./dist/Ecctrl.cjs",
    "import": "./dist/Ecctrl.js"
  },
  "sideEffects": false,
  "devDependencies": {
    "@react-three/drei": "9.80.0",
    "@react-three/fiber": "8.13.6",
    "@react-three/rapier": "1.1.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "4.0.4",
    "r3f-perf": "7.1.2",
    "typescript": "5.1.6",
    "vite": "4.4.9"
  },
  "dependencies": {
    "@react-spring/three": "9.7.3",
    "@types/three": "0.152.1",
    "leva": "0.9.35",
    "zustand": "4.4.1"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9.0.0 <10.0.0",
    "@react-three/fiber": ">=8.0.0 <9.0.0",
    "@react-three/rapier": ">=1.0.0 <2.0.0",
    "react": ">=18.0.0 <19.0.0",
    "react-dom": ">=18.0.0 <19.0.0",
    "three": ">=0.150.0 <0.160.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview"
  }
